{
	"name": "ihunt",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"client",
		"admin",
		"server",
		"lib"
	],
	"type": "module",
	"scripts": {
		"dev": "concurrently npm:dev:client npm:dev:server",
		"build": "yarn build:prisma && yarn build:server",
		"build:scripts": "esbuild scripts/*.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=scripts/dist",
		"lint": "oxlint --type-aware",
		"lint:all": "concurrently npm:lint npm:typecheck npm:fmt:check",
		"typecheck": "tsc --noEmit",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"prepare": "husky",
		"docker:prod": "docker compose -f config/docker-compose.prod.yml --project-directory=."
	},
	"devDependencies": {
		"concurrently": "^9.2.1",
		"csv-parse": "^7.0.0",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.58.0",
		"oxlint-tsgolint": "^0.21.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.58.0"
	},
	"lint-staged": {
		"!(*gen).{js,jsx,ts,tsx}": [
			"yarn run lint",
			"yarn run fmt"
		],
		"*.{json,css,scss,html}": "yarn run fmt"
	},
	"engines": {
		"node": ">=26.0.0"
	},
	"packageManager": "yarn@4.18.1"
}
