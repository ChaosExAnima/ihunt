{
	"name": "ihunt",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"client",
		"admin",
		"server",
		"lib"
	],
	"type": "module",
	"scripts": {
		"dev": "concurrently npm:dev:client npm:dev:admin npm:dev:server",
		"dev:admin": "yarn workspace @ihunt/admin dev",
		"dev:client": "yarn workspace @ihunt/client dev",
		"dev:server": "yarn workspace @ihunt/server dev",
		"build": "yarn build:prisma && yarn build:server && yarn build:client && yarn build:admin",
		"build:admin": "yarn workspace @ihunt/admin build",
		"build:client": "yarn workspace @ihunt/client build",
		"build:prisma": "yarn workspace @ihunt/server build:prisma",
		"build:server": "yarn workspace @ihunt/server build",
		"build:scripts": "yarn workspace @ihunt/server build:scripts",
		"studio": "yarn workspace @ihunt/server studio",
		"lint": "oxlint --type-aware",
		"lint:all": "concurrently npm:lint npm:typecheck npm:fmt:check",
		"typecheck": "yarn workspaces foreach --all --parallel run typecheck",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"prepare": "husky",
		"docker:prod": "docker compose -f config/docker-compose.prod.yml --project-directory=."
	},
	"devDependencies": {
		"concurrently": "^10.0.0",
		"csv-parse": "^7.0.0",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.58.0",
		"oxlint-tsgolint": "^0.25.0",
		"tsx": "^4.21.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.58.0"
	},
	"lint-staged": {
		"!(*gen).{js,jsx,ts,tsx}": [
			"yarn run lint",
			"yarn run fmt"
		],
		"*.{json,css,scss,html}": "yarn run fmt"
	},
	"engines": {
		"node": ">=26.0.0"
	},
	"packageManager": "yarn@4.18.1"
}
