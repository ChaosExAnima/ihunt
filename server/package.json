{
	"name": "@ihunt/server",
	"private": true,
	"type": "module",
	"main": "index.ts",
	"scripts": {
		"dev": "NODE_ENV=development nodemon -w . -w ../lib --exec tsx server.ts",
		"prisma": "prisma generate",
		"studio": "prisma studio",
		"build": "esbuild server.ts --bundle --platform=node --target=node24 --format=esm --packages=external --alias:@ihunt/lib=../lib --outfile=server.js",
		"build:scripts": "esbuild scripts/*.ts --bundle --platform=node --target=node24 --format=esm --packages=external --alias:@ihunt/lib=../lib --outdir=scripts/dist",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@fastify/cors": "^11.2.0",
		"@ihunt/lib": "workspace:^",
		"@imgproxy/imgproxy-js-core": "^1.7.0",
		"@imgproxy/imgproxy-node": "^1.1.0",
		"@prisma/adapter-pg": "^7.4.2",
		"@prisma/client": "^7.4.2",
		"@trpc/server": "^11.16.0",
		"bcryptjs": "^3.0.3",
		"dotenv": "^17.4.0",
		"fastify": "^5.8.4",
		"iron-session": "^8.0.4",
		"pino-pretty": "^13.1.3",
		"prisma": "^7.6.0",
		"sharp": "^0.35.0",
		"superjson": "^2.2.6",
		"thumbhash": "^0.1.1",
		"web-push": "^3.6.7",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^24.12.0",
		"@types/web-push": "^3.6.4",
		"esbuild": "^0.28.0",
		"nodemon": "^3.1.14",
		"trpc-ui": "npm:trpc-ui-zod4@^1.0.0"
	},
	"packageManager": "yarn@4.18.1"
}
